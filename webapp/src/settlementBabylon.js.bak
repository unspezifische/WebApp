import { Color3, Vector3, VertexData } from '@babylonjs/core';
import {
  createTerrainHeightSampler,
  FEET_PER_SCENE_UNIT,
  roadWidthAt,
  terrainSurfaceWeights,
  waterDepthAtSeaLevel,
} from './settlementEditor';

export const TERRAIN_SEGMENTS = 256;

const DEFAULT_BOUNDS = { minX: -900, maxX: 900, minY: -900, maxY: 900, width: 1800, height: 1800 };

export const worldToBabylon = (xFeet, yFeet, elevationFeet = 0) => {
  return new Vector3(
    xFeet / FEET_PER_SCENE_UNIT,
    elevationFeet / FEET_PER_SCENE_UNIT,
    yFeet / FEET_PER_SCENE_UNIT
  );
};

export const babylonToWorld = (point) => {
  return {
    x: point.x * FEET_PER_SCENE_UNIT,
    y: point.z * FEET_PER_SCENE_UNIT,
    elevation: point.y * FEET_PER_SCENE_UNIT,
  };
};



function pointInsideRegion(x, y, region) {
  let inside = false;
  const points = region?.points || [];
  for (let index = 0, previous = points.length - 1; index < points.length; previous = index++) {
    const current = points[index], prior = points[previous];
    if (((current.y > y) !== (prior.y > y)) && x < (prior.x - current.x) * (y - current.y) / ((prior.y - current.y) || .000001) + current.x) inside = !inside;
  }
  return inside;
}

function colorForTerrain(elevation, x, y, terrainMaterial) {
  const palette = {
    sand: Color3.FromHexString('#cdbb82'), grass: Color3.FromHexString('#66844e'), dirt: Color3.FromHexString('#80684b'), rock: Color3.FromHexString('#77766f'), snow: Color3.FromHexString('#e8edf0'),
  };
  const weights = terrainSurfaceWeights(elevation, 1, terrainMaterial);
  let output = new Color3(0, 0, 0);
  Object.entries(weights).forEach(([surface, weight]) => output.addInPlace(palette[surface].scale(weight)));
  const region = [...(terrainMaterial?.regions || [])].reverse().find(candidate => pointInsideRegion(x, y, candidate));
  if (region?.region_type === 'city') output = Color3.Lerp(output, palette.dirt, .82);
  return output;
}

export function terrainVertexData(strokes, bounds, heightMap, terrainMaterial = {}) {
  const sampleHeight = createTerrainHeightSampler(strokes, heightMap);
  const positions = [], indices = [], uvs = [], colors = [];

  for (let row = 0; row <= TERRAIN_SEGMENTS; row += 1) {
    // Step forward naturally across rows (North to South)
    const y = bounds.minY + (row / TERRAIN_SEGMENTS) * bounds.height;

    for (let column = 0; column <= TERRAIN_SEGMENTS; column += 1) {
      const x = bounds.minX + (column / TERRAIN_SEGMENTS) * bounds.width;
      const elevation = sampleHeight(x, y);

      // Push standard un-inverted coordinates straight to the mesh buffer channel arrays
      positions.push(x / FEET_PER_SCENE_UNIT, elevation / FEET_PER_SCENE_UNIT, y / FEET_PER_SCENE_UNIT);
      uvs.push(column / TERRAIN_SEGMENTS, row / TERRAIN_SEGMENTS); // Standard V indexing fixes image projections


      const surface = colorForTerrain(elevation, x, y, terrainMaterial);
      colors.push(surface.r, surface.g, surface.b, 1);
    }
  }



  for (let row = 0; row < TERRAIN_SEGMENTS; row += 1) for (let column = 0; column < TERRAIN_SEGMENTS; column += 1) {
    const a = row * (TERRAIN_SEGMENTS + 1) + column, b = a + 1, c = a + TERRAIN_SEGMENTS + 1, d = c + 1;
    indices.push(a, b, c, b, d, c);
  }
  const normals = [];
  VertexData.ComputeNormals(positions, indices, normals);
  const data = new VertexData();
  data.positions = positions;
  data.indices = indices;
  data.uvs = uvs;
  data.colors = colors;
  data.normals = normals;
  return data;
}

function catmullRom(a, b, c, d, amount) {
  const amountSquared = amount * amount, amountCubed = amountSquared * amount;
  return new Vector3(
    .5 * ((2 * b.x) + (-a.x + c.x) * amount + (2 * a.x - 5 * b.x + 4 * c.x - d.x) * amountSquared + (-a.x + 3 * b.x - 3 * c.x + d.x) * amountCubed),
    .5 * ((2 * b.y) + (-a.y + c.y) * amount + (2 * a.y - 5 * b.y + 4 * c.y - d.y) * amountSquared + (-a.y + 3 * b.y - 3 * c.y + d.y) * amountCubed),
    .5 * ((2 * b.z) + (-a.z + c.z) * amount + (2 * a.z - 5 * b.z + 4 * c.z - d.z) * amountSquared + (-a.z + 3 * b.z - 3 * c.z + d.z) * amountCubed),
  );
}

function splinePoint(points, amount) {
  const scaled = amount * (points.length - 1), index = Math.min(points.length - 2, Math.floor(scaled)), local = scaled - index;
  return catmullRom(points[Math.max(0, index - 1)], points[index], points[index + 1], points[Math.min(points.length - 1, index + 2)], local);
}

export function roadVertexData(road, strokes, heightMap, bounds, heightSampler = createTerrainHeightSampler(strokes, heightMap)) {
  // Pass your active bounds mapping array down into your projection utility hook
  const source = (road.points || []).map(point => worldToBabylon(point.x, point.y, 0, bounds));
  if (source.length < 2) return new VertexData();

  const samples = Math.max(32, source.length * 32), positions = [], indices = [], uvs = [];

  for (let index = 0; index <= samples; index += 1) {
    const amount = index / samples, point = splinePoint(source, amount), nearby = splinePoint(source, Math.min(1, amount + 1 / samples));
    const tangent = nearby.subtract(point).normalize(), halfWidth = roadWidthAt(road, amount) / (2 * FEET_PER_SCENE_UNIT);
    const normal = new Vector3(-tangent.z, 0, tangent.x).scale(halfWidth);
    const left = point.add(normal), right = point.subtract(normal);

    const centerWorldX = point.x * FEET_PER_SCENE_UNIT;
    const centerWorldY = -point.z * FEET_PER_SCENE_UNIT;
    const groundElevation = (heightSampler(centerWorldX, centerWorldY) + 0.15) / FEET_PER_SCENE_UNIT; // Stable terrain buffer padding

    positions.push(
      left.x, groundElevation, left.z,
      right.x, groundElevation, right.z
    );

    uvs.push(0, amount * 8, 1, amount * 8);
    if (index < samples) { const offset = index * 2; indices.push(offset, offset + 2, offset + 1, offset + 1, offset + 2, offset + 3); }
  }

  const normals = [];
  VertexData.ComputeNormals(positions, indices, normals);
  const data = new VertexData();
  data.positions = positions;
  data.indices = indices;
  data.uvs = uvs;
  data.normals = normals;
  return data;
}

export function fortificationVertexData(wall, strokes, heightMap) {
  const source = (wall.points || []).map(point => worldToBabylon(point.x, point.y));
  if (source.length < 2) return new VertexData();
  const samples = Math.max(24, source.length * 18), positions = [], indices = [];
  const halfWidth = (Number(wall.width_feet) || 24) / (2 * FEET_PER_SCENE_UNIT), height = (Number(wall.height_feet) || 35) / FEET_PER_SCENE_UNIT;
  const heightSampler = createTerrainHeightSampler(strokes, heightMap);
  for (let index = 0; index <= samples; index += 1) {
    const amount = index / samples, point = splinePoint(source, amount), nearby = splinePoint(source, Math.min(1, amount + 1 / samples));
    const tangent = nearby.subtract(point).normalize(), normal = new Vector3(-tangent.z, 0, tangent.x).scale(halfWidth);
    const left = point.add(normal), right = point.subtract(normal);
    
    const centerWorldX = point.x * FEET_PER_SCENE_UNIT;
    const centerWorldY = -point.z * FEET_PER_SCENE_UNIT;
    const wallBaseElevation = heightSampler(centerWorldX, centerWorldY) / FEET_PER_SCENE_UNIT;

    positions.push(
      left.x, wallBaseElevation, left.z,
      right.x, wallBaseElevation, right.z,
      left.x, wallBaseElevation + height, left.z,
      right.x, wallBaseElevation + height, right.z
    );

    if (index < samples) {
      const offset = index * 4, next = offset + 4;
      indices.push(offset, next, offset + 2, offset + 2, next, next + 2, offset + 1, offset + 3, next + 1, offset + 3, next + 3, next + 1, offset + 2, next + 2, offset + 3, offset + 3, next + 2, next + 3);
    }
  }
  const normals = [];
  VertexData.ComputeNormals(positions, indices, normals);
  const data = new VertexData();
  data.positions = positions;
  data.indices = indices;
  data.normals = normals;
  return data;
}

export function riverVertexData(body, strokes, heightMap) {
  const source = [...(body.points || [])];
  if (source.length < 2) return new VertexData();

  if (createTerrainHeightSampler(strokes, heightMap)(source[0].x, source[0].y) < createTerrainHeightSampler(strokes, heightMap)(source.at(-1).x, source.at(-1).y)) source.reverse();
  const points = source.map(point => worldToBabylon(point.x, point.y));
  const samples = Math.max(36, points.length * 28), positions = [], indices = [], uvs = [];
  const heightSampler = createTerrainHeightSampler(strokes, heightMap);
  let previousHeight = Infinity;

  for (let index = 0; index <= samples; index += 1) {
    const amount = index / samples, point = splinePoint(points, amount), nearby = splinePoint(points, Math.min(1, amount + 1 / samples));
    const tangent = nearby.subtract(point).normalize(), normal = new Vector3(-tangent.z, 0, tangent.x).scale((Number(body.width_feet) || 30) / (2 * FEET_PER_SCENE_UNIT));
    
    const streamWorldX = point.x * FEET_PER_SCENE_UNIT;
    const streamWorldY = -point.z * FEET_PER_SCENE_UNIT;
    // This ensures rivers flow downhill naturally without cutting holes or floating over banks
    previousHeight = Math.min(previousHeight, heightSampler(streamWorldX, streamWorldY) - 0.2); 

    positions.push(
      left.x, previousHeight / FEET_PER_SCENE_UNIT, left.z, 
      right.x, previousHeight / FEET_PER_SCENE_UNIT, right.z
    );

    const left = point.add(normal);
    const right = point.subtract(normal);
    positions.push(left.x, previousHeight / FEET_PER_SCENE_UNIT, left.z, right.x, previousHeight / FEET_PER_SCENE_UNIT, right.z);
    uvs.push(0, amount * 10, 1, amount * 10);
    if (index < samples) { const offset = index * 2; indices.push(offset, offset + 2, offset + 1, offset + 1, offset + 2, offset + 3); }
  }
  
  const normals = [];
  VertexData.ComputeNormals(positions, indices, normals);
  const data = new VertexData();
  data.positions = positions;
  data.indices = indices;
  data.uvs = uvs;
  data.normals = normals;
  return data;
}

export function oceanVertexData(bounds, strokes, heightMap, seaLevel) {
  const segments = 96, positions = [], indices = [], uvs = [], depths = [], exposures = [];
  const heightSampler = createTerrainHeightSampler(strokes, heightMap);
  const edges = { west: [], east: [], north: [], south: [] };
  for (let index = 0; index <= segments; index += 1) {
    const amount = index / segments, x = bounds.minX + amount * bounds.width, y = bounds.minY + amount * bounds.height;
    edges.west.push(heightSampler(bounds.minX, y)); edges.east.push(heightSampler(bounds.maxX, y));
    edges.north.push(heightSampler(x, bounds.maxY)); edges.south.push(heightSampler(x, bounds.minY));
  }
  const average = values => values.reduce((sum, value) => sum + value, 0) / Math.max(1, values.length);
  const source = Object.entries(edges).sort((left, right) => average(left[1]) - average(right[1]))[0][0];
  const waveDirection = { west: { x: -1, y: 0 }, east: { x: 1, y: 0 }, north: { x: 0, y: 1 }, south: { x: 0, y: -1 } }[source];
  for (let row = 0; row <= segments; row += 1) for (let column = 0; column <= segments; column += 1) {
    const x = bounds.minX + column / segments * bounds.width, y = bounds.minY + row / segments * bounds.height, depth = waterDepthAtSeaLevel(heightSampler(x, y), seaLevel);
    let exposure = 1;
    if (depth > 0) for (let distance = Math.max(bounds.width, bounds.height) / 24; distance < Math.max(bounds.width, bounds.height); distance += Math.max(bounds.width, bounds.height) / 24) {
      const sampleX = x + waveDirection.x * distance, sampleY = y + waveDirection.y * distance;
      if (sampleX < bounds.minX || sampleX > bounds.maxX || sampleY < bounds.minY || sampleY > bounds.maxY) break;
      if (heightSampler(sampleX, sampleY) >= seaLevel) { exposure = .18; break; }
    }
    positions.push(x / FEET_PER_SCENE_UNIT, seaLevel / FEET_PER_SCENE_UNIT, -y / FEET_PER_SCENE_UNIT);
    uvs.push(column / segments, row / segments); depths.push(depth / FEET_PER_SCENE_UNIT); exposures.push(exposure);
  }
  for (let row = 0; row < segments; row += 1) for (let column = 0; column < segments; column += 1) {
    const a = row * (segments + 1) + column, b = a + 1, c = a + segments + 1, d = c + 1;
    indices.push(a, b, c, b, d, c);
  }
  const normals = [];
  VertexData.ComputeNormals(positions, indices, normals);
  const data = new VertexData();
  data.positions = positions;
  data.indices = indices;
  data.uvs = uvs;
  data.normals = normals;
  data.set(depths, 'waterDepth');
  data.set(exposures, 'waveExposure');
  data.waveDirection = waveDirection;
  return data;
}

export function regionVertexData(region, strokes, heightMap) {
  const points = region.points || [];
  if (points.length < 3) return new VertexData();
  const minX = Math.min(...points.map(point => point.x)), maxX = Math.max(...points.map(point => point.x)), minY = Math.min(...points.map(point => point.y)), maxY = Math.max(...points.map(point => point.y));
  const step = Math.max(12, Math.max(maxX - minX, maxY - minY, 1) / 42), positions = [], indices = [];
  const heightSampler = createTerrainHeightSampler(strokes, heightMap);
  for (let y = minY; y < maxY; y += step) for (let x = minX; x < maxX; x += step) {
    const x2 = Math.min(maxX, x + step), y2 = Math.min(maxY, y + step);
    if (!pointInsideRegion((x + x2) / 2, (y + y2) / 2, region)) continue;
    const offset = positions.length / 3;
    [[x, y], [x2, y], [x2, y2], [x, y2]].forEach(([vertexX, vertexY]) => positions.push(vertexX / FEET_PER_SCENE_UNIT, (heightSampler(vertexX, vertexY) + 1.8) / FEET_PER_SCENE_UNIT, -vertexY / FEET_PER_SCENE_UNIT));
    indices.push(offset, offset + 1, offset + 2, offset, offset + 2, offset + 3);
  }
  const normals = [];
  VertexData.ComputeNormals(positions, indices, normals);
  const data = new VertexData();
  data.positions = positions;
  data.indices = indices;
  data.normals = normals;
  return data;
}